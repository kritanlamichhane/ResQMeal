{
  "name": "resqmeal-fullstack",
  "version": "1.0.0",
  "description": "ResQMeal - Food Surplus Reduction Platform Workspace",
  "private": true,
  "scripts": {
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "npx concurrently -k --kill-others-on-fail -p \"[{name}]\" -n \"backend,frontend\" -c \"cyan,magenta\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "test:backend": "pytest -v backend/tests/",
    "test:concurrency": "pytest -v backend/tests/test_concurrency_reservation.py"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}