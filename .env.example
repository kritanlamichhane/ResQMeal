# ResQMeal Environment Configuration

# Application
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
SECRET_KEY=supersecretkey-resqmeal-production-grade-jwt-token-key-2025
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL if available, automatically falls back to SQLite for local development)
DATABASE_URL=sqlite:///./resqmeal.db
# Example for PostgreSQL + PostGIS:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resqmeal

# Redis (Optional: if not reachable, gracefully falls back to thread-safe in-memory cache)
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI / ML Service Settings
MODEL_CACHE_DIR=./ml_models
DEFAULT_SURPLUS_DISCOUNT_PERCENT=40
